Bootstrap: docker
From: ubuntu:22.04

%files
	Tomls/pixi.toml /opt/pixi-projects/pixi.toml


%post
    apt-get update && apt-get install -y curl bzip2 ca-certificates build-essential libcurl4-openssl-dev libssl-dev libxml2-dev
    
    # Creiamo una cartella dedicata alla radice (root-level)
    # È sicura, visibile a tutti e non viene sovrascritta dai mount
    mkdir -p /pixi_app
    
    # Diciamo a Pixi di installarsi lì
    export PIXI_HOME=/pixi_app
    curl -fsSL https://pixi.sh/install.sh | bash
    
    export PATH="/pixi_app/bin:$PATH"
	mkdir /pixi_env
    cd /pixi_env
	cp /opt/pixi-projects/pixi.toml .
	pixi run model-download-all
    
   	export PATH="/pixi_env/.pixi/envs/default/bin:$PATH"


%environment
    # Aggiungiamo i binari dell ambiente specifico al PATH
    export PATH="/pixi_env/.pixi/envs/default/bin:$PATH"
    export LC_ALL=C.UTF-8

%test
    which dorado